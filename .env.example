# AI Instant Fix — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# ── Flask API server (server/app.py) ──────────────────
PORT=5556
# Generate strong random values:  openssl rand -hex 32
JWT_SECRET=
*** Shared HMAC secret — must match AIF_WEBHOOK_SECRET on the PHP side
WEBHOOK_SECRET=
# CORS: comma-separated allowed origins for the /api/* routes.
# Leave empty for local dev only (allows *). In production set e.g.:
#   AIF_ALLOWED_ORIGIN=https://example.com,https://www.example.com
AIF_ALLOWED_ORIGIN=
# Admin password for POST /api/auth/login (requires JWT_SECRET set)
ADMIN_PASSWORD=
*** DEV-ONLY escape hatch: set to 1 to let JWT-protected routes accept
# anonymous requests when JWT_SECRET is unset. NEVER in production —
# the server prints a loud warning banner while it is active.
DEV_ALLOW_ANON=

*** Optional Telegram completion notifications
TELEGRAM_BOT_TOKEN=
*** Get yours from @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ── AI executor (pluggable — any CLI agent) ──────────
# Mode 1: EXECUTOR_CMD set → run locally as a shell template.
#   Placeholders: {prompt_file} (required), {task_id}, {user_id}, {url}
#   Examples:
#     EXECUTOR_CMD='hermes chat --query-file {prompt_file}'
#     EXECUTOR_CMD='claude -p "$(cat {prompt_file})"'
#     EXECUTOR_CMD='codex exec "$(cat {prompt_file})"'
#     EXECUTOR_CMD='/opt/my-agent/run.sh {prompt_file}'
EXECUTOR_CMD=
# Label passed to the executor / shown in logs (free-form)
EXECUTOR_PROFILE=default

# WordPress/PHP side (used by /api/poll). Leave empty to disable polling.
PHP_API_URL=
# Worker queue integration (Mode 2 — used when EXECUTOR_CMD is empty)
POWER_TOOL_URL=http://localhost:5557
POWER_TOOL_CLIENT_ID=1

# ── PHP API endpoint (wp-plugin/api.php) ─────────────
DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASS=
DB_PREFIX=wp_
# Executor webhook URL (the AI agent server that processes tasks)
AIF_EXECUTOR_WEBHOOK=
AIF_WEBHOOK_SECRET=
AIF_TEL…AT=
# CORS: set to your site origin in production, e.g. https://example.com
AIF_ALLOWED_ORIGIN=

# ── Universal PHP backend (universal/fizi-ai.php) ────
DB_ENGINE=sqlite
AUTH_USER=admin
AUTH_PASS=
ACCESS_MODE=all
IP_WHITELIST=127.0.0.1,::1

# ── Deployment topology ────────────────────────────────────────
# SPLIT (shared-hosting front-end): set PHP_API_URL to the remote
#   api.php; run a 30s timer that calls GET /api/poll on this server.
# CONSOLIDATED (single VPS): set AIF_EXECUTOR_WEBHOOK=http://127.0.0.1:5556/api/webhook/task
#   in the WP plugin env, WEBHOOK_SECRET=*** value as AIF_WEBHOOK_SECRET
#   here, and disable the poll timer. See README "Deployment Topologies".
